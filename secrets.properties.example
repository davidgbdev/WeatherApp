# Copia este archivo a secrets.properties y sustituye los valores.
# secrets.properties no se versiona. No pongas claves reales en este ejemplo.
#
# Weatherstack: https://weatherstack.com/signup/free
#   El access key aparece en https://weatherstack.com/dashboard
# Mapbox: https://account.mapbox.com/access-tokens/

WEATHERSTACK_ACCESS_KEY=your_weatherstack_access_key_here
MAPBOX_TOKEN=your_mapbox_public_token_here
MAPBOX_DOWNLOADS_TOKEN=your_mapbox_downloads_token_here
